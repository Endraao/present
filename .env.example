# Copy to .env and fill in. Never commit .env.

# https://console.groq.com -> API Keys (free)
GROQ_API_KEY=

# https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional
# PRESENT_VIPS=alice,bob                  # usernames that always reach you
# PRESENT_ALERT_WORDS=urgent,outage,hacked
# PORT=8787

# Optional: demo bot that plays "the outside world" (server/scripts/demo.ts)
# TELEGRAM_BOT_TOKEN=
# DEMO_GROUP_ID=
# DEMO_DM_ID=
# DEMO_ME=@yourusername
